# Поскольку есть ansible.ini, то флаг -i inventory.ini можно пропустить
verify:
ansible-inventory -i inventory.ini --list
ping:
ansible myhosts -m ping -i inventory.ini
run playbook:
ansible-playbook -i inventory.ini playbook.yml -K -v
ansible-playbook -i inventory.ini main.yml --skip-tags database
ansible-playbook -i inventory.ini main.yml --tags webserver
ansible-playbook -i inventory.ini main.yml --skip-tags "database,webserver"
